<<test helpers>>=
class FakeGrade:
  def __init__(self, code):
    self.code = code


class FakeResult:
  def __init__(self, component, grade=None, date=None):
    self.component = component
    self.grade = FakeGrade(grade) if grade is not None else None
    self.date = date


class FakeCourse:
  def __init__(self, code, round_code, start, end, components, results,
               education_id="education"):
    self.code = code
    self.round_code = round_code
    self.start = start
    self.end = end
    self._components = components
    self._results = results
    self.education_id = education_id

  def components(self):
    return self._components

  def results(self):
    return self._results


class FakeLadokForProgramData:
  def __init__(self, program_participants=None, course_participations=None,
               registrations=None):
    self._program_participants = program_participants or []
    self._course_participations = course_participations or {}
    self._registrations = registrations or []

  def program_round_participants_JSON(self, round_uid):
    return self._program_participants

  def get_student(self, uid):
    return SimpleNamespace(
      ladok_id=uid,
      personnummer=f"{uid}-pnr",
      __str__=lambda self: f"student {uid}")

  def student_course_registrations_JSON(self, student_uid):
    return self._course_participations.get(student_uid, [])

  def registrations_on_course_JSON(self, education_id, student_id):
    return self._registrations


class FakeCourseRegistration:
  def __init__(self, /, **kwargs):
    self.code = kwargs["Utbildningskod"]
    self.round_code = kwargs["Utbildningstillfalleskod"]
    dates = kwargs["Studieperiod"]
    self.start = datetime.date.fromisoformat(dates["Startdatum"])
    self.end = datetime.date.fromisoformat(dates["Slutdatum"])
    self.education_id = kwargs["UtbildningUID"]
    self._components = kwargs["components"]
    self._results = kwargs["results"]

  def components(self):
    return self._components

  def results(self):
    return self._results
