The headers and row builders keep the command logic narrow: the command path
decides which objects to export, while these helpers define how the CSV should
look.
<<functions>>=
def course_header():
  """Return the CSV header for course exports."""
  return ["Course", "Round", "Component", "Student", "Grade", "Time"]

def program_header():
  """Return the CSV header for program exports."""
  return ["Program"] + course_header()

def course_row(course, student, component, grade, time):
  """Return one CSV row for a course export."""
  return [course.code, course.round_code, component, student, grade, time]

def program_row(program, course, student, component, grade, time):
  """Return one CSV row for a program export."""
  return [program] + course_row(course, student, component, grade, time)
@

We filter the rounds.
<<functions>>=
def filter_rounds(all_rounds, desired_rounds):
  """Returns only the round objects with round code in desired_rounds."""
  if not desired_rounds:
    return all_rounds
  return filter(
    lambda x: x.round_code in desired_rounds,
    all_rounds
  )

def filter_program_rounds(all_rounds, desired_rounds):
  """Return only the program rounds with round code in desired_rounds."""
  if not desired_rounds:
    return all_rounds
  return filter(
    lambda x: x["Utbildningstillfalleskod"] in desired_rounds,
    all_rounds
  )

def format_program_round(program_code, program_round):
  """Return a cohort label for a program round."""
  start = datetime.date.fromisoformat(
    program_round["SammanslagenTillfallesperiod"]["Startdatum"])
  return f"{program_code} {program_round['Utbildningstillfalleskod']} {start.year}"
@ We need a list of desired rounds.
<<add data command arguments to data parser>>=
data_parser.add_argument("-r", "--rounds", nargs="+",
  help="The round codes for the rounds to include, "
    "otherwise all rounds will be included.")
