Replay must never reach the network, not even by mistake.
In [[pyproject.toml]] we therefore give [[pytest]] the options
[[--block-network --allowed-hosts=127.0.0.1,::1,localhost]]: any request to
another host then fails, unless a live run or a recording turns the block off.


\section{Choosing the mode}

The two live options are separate because they carry different risks.
A read test only looks at the data, while a write test changes it.
<<command-line options>>=
def pytest_addoption(parser):
  group = parser.getgroup("ladok3")
  group.addoption(
    "--live", action="store_true",
    help="run the tests against LADOK's test environment, record into a "
         "temporary directory and compare with the cassettes "
         "(attended: may prompt for MFA)")
  group.addoption(
    "--live-writes", action="store_true",
    help="with --live or --record-mode, also run the tests that change "
         "data in LADOK's test environment")
  group.addoption(
    "--live-dir", default=None,
    help="where --live records, as --live-dir=PATH "
         "(default: a private directory under the temporary directory)")
@

A live run is a recording that goes elsewhere.
We set the record mode to [[all]], so every request goes to LADOK, and turn
the network block off.
We have to set the options themselves rather than the fixtures, because
[[pytest-recording]] reads its network block from the options.
Recording needs the pseudonymization key; without it we refuse to start
rather than record anyone's data in clear.
<<test configuration>>=
def pytest_configure(config):
  config.addinivalue_line(
    "markers",
    "mutates: the test changes data in LADOK; reaches LADOK only with "
    "--live-writes")
  config._recorded_dirs = set()
  if config.getoption("--live"):
    config.option.record_mode = "all"
    config.option.block_network = False
    config._live_dir = live_directory(config)
    prepare_live_dir(config._live_dir, Path(str(config.rootpath)).resolve())
  if record_mode_of(config) != "none" \
      and not os.environ.get(vcr_support.KEY_ENV):
    pytest.exit(f"refusing to record: set {vcr_support.KEY_ENV} so that "
                "personal data is pseudonymized", returncode=2)


def record_mode_of(config):
  """Return the record mode, `none` meaning replay."""
  return config.getoption("--record-mode") or "none"
@

The live recordings hold real people's data, pseudonymized, so they go in a
private directory outside the repository rather than in the shared temporary
directory.
The directory name includes a hash of the project's path, so two checkouts
don't share one.
<<test configuration>>=
def live_directory(config):
  """Return the directory that a live run records into."""
  root = Path(str(config.rootpath))
  tag = hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:10]
  return Path(config.getoption("--live-dir")
              or vcr_support.private_dir()
                 / f"{root.name}-{tag}-live-cassettes").resolve()
@

A live run starts with an empty directory, so that recordings from an earlier
run can't hide that a request is no longer made.
Emptying a directory is dangerous if the path is mistyped, so we only empty a
directory that an earlier live run wrote, as shown by a marker file, and we
never accept a directory that contains the project.
<<constants>>=
LIVE_MARKER_FILE = ".pytest-live-cassettes"
<<test configuration>>=
def prepare_live_dir(live_dir, root):
  """Empty `live_dir` for a live run, if an earlier live run made it."""
  if live_dir == root or live_dir in root.parents:
    pytest.exit(f"refusing --live-dir={live_dir}: it contains the project",
                returncode=2)
  if live_dir.exists() and any(live_dir.iterdir()):
    if not (live_dir / LIVE_MARKER_FILE).exists():
      pytest.exit(f"refusing to empty --live-dir={live_dir}: it has files "
                  "that an earlier live run did not write", returncode=2)
    shutil.rmtree(live_dir)
  live_dir.mkdir(parents=True, exist_ok=True)
  (live_dir / LIVE_MARKER_FILE).write_text(
    "written by pytest --live; safe to delete\n")
@

Let's verify that a live run empties only its own directory.
<<test functions>>=
def test_prepare_live_dir_empties_only_its_own(tmp_path):
  project = tmp_path / "project"
  live = tmp_path / "live"
  conftest.prepare_live_dir(live, project)
  (live / "old.yaml").write_text("from an earlier live run")
  conftest.prepare_live_dir(live, project)
  assert not (live / "old.yaml").exists()

def test_prepare_live_dir_refuses_foreign_files(tmp_path):
  live = tmp_path / "live"
  live.mkdir()
  (live / "precious.txt").write_text("not ours")
  with pytest.raises(pytest.exit.Exception):
    conftest.prepare_live_dir(live, tmp_path / "project")
  assert (live / "precious.txt").exists()

def test_prepare_live_dir_refuses_the_project(tmp_path):
  with pytest.raises(pytest.exit.Exception):
    conftest.prepare_live_dir(tmp_path, tmp_path / "project")
@

A [[mutates]] test is skipped when it would reach LADOK, in a live run or
while recording, unless we asked for writes.
In replay it runs: then its writes go to the cassette, not to LADOK.
<<collection rules>>=
def pytest_collection_modifyitems(config, items):
  talks_to_ladok = record_mode_of(config) != "none"
  if not talks_to_ladok or config.getoption("--live-writes"):
    return
  skip_writes = pytest.mark.skip(
    reason="changes data in LADOK; add --live-writes")
  for item in items:
    if "mutates" in item.keywords:
      item.add_marker(skip_writes)
@

Let's verify the rule in each mode, by running [[pytest]] on a small test
file with this configuration.
The inner run replaces the login fixture, so it never logs in to LADOK,
whatever mode it is in.
<<test functions>>=
INNER_TESTS = """
import pytest

@pytest.fixture(scope="session", autouse=True)
def live_ladok():
  return "the inner run never logs in"

@pytest.mark.mutates
def test_writes():
  pass

def test_reads():
  pass
"""

@pytest.mark.parametrize("options,passed,skipped", [
  ([], 2, 0),
  (["--live"], 1, 1),
  (["--live", "--live-writes"], 2, 0),
])
def test_mutates_tests_reach_ladok_only_with_live_writes(
    pytester, monkeypatch, tmp_path, options, passed, skipped):
  monkeypatch.setenv("TEST_PSEUDONYM_KEY", "a key for the inner run")
  pytester.makeconftest(pathlib_text(conftest.__file__))
  pytester.makepyfile(test_inner=INNER_TESTS)
  result = pytester.runpytest_inprocess(
    *options, f"--live-dir={tmp_path / 'live'}", "-p", "no:cacheprovider")
  result.assert_outcomes(passed=passed, skipped=skipped)

def pathlib_text(path):
  with open(path, encoding="utf-8") as file:
    return file.read()
@


\section{Sessions for the tests}

When we talk to LADOK, all tests share one session,
[[ladok3.test_session]].
It reuses the cached login from [[ladok login]] (\cref{CachedSession}), so
a live run usually needs no new MFA prompt.

The login must not end up in a cassette.
The SAML response that the login posts back to LADOK is the signed identity
of whoever logged in, and no scrubber can read it.
We therefore log in before any cassette opens.
[[pytest-recording]] opens a test's cassette in a function-scoped fixture,
and [[pytest]] sets up session-scoped fixtures before function-scoped ones,
so a session-scoped fixture that makes the first request does the login
outside every cassette.
It must be [[autouse]], because a fixture that a test asks for by name may
be set up after the cassette is already open.
When there are no stored credentials, [[ladok3.test_session]] raises
[[RuntimeError]].
The tests that need LADOK are then skipped rather than failed, since the
problem is the machine's set-up, not the code; the fixture itself must not
skip, because skipping an [[autouse]] fixture would skip the offline tests
too.
Any other error is left to fail, because it may well be a bug in the login
code.
<<fixtures>>=
@pytest.fixture(scope="session")
def recording(record_mode):
  """True when the tests talk to LADOK: a live run or a recording."""
  return record_mode != "none"


@pytest.fixture(scope="session", autouse=True)
def live_ladok(recording, pytestconfig):
  """The logged-in session for LADOK's test environment, or the reason why
  there is none.  Logs in before any cassette opens."""
  if not recording:
    return "replaying"
  return log_in_for_tests(lambda: ladok3.test_session,
                          into_project=not pytestconfig.getoption("--live"))
@

Skipping is right for a live run, which records into a directory of its own.
It is wrong when we record into the project's cassettes.
With [[--record-mode=rewrite]], [[pytest-recording]] deletes a test's
cassette when it opens it, and that happens before the [[ladok]] fixture
learns that there is no login and skips.
A run whose login failed then deletes the very cassettes that it was meant to
renew, and still exits successfully, reporting only skips.
So when we record into the project, a failed login stops the whole run, here,
before any cassette opens.

One [[RuntimeError]] is not a missing login: [[RecursionError]].
It is how a login that loops ends, so it is a bug, and we let it fail.
This is not hypothetical.
A [[weblogin]] handler that another program had added to the cached session
once replayed a one-time step of the login, over and over, for a quarter of an
hour; the [[RecursionError]] at the end was taken for missing credentials, the
tests were skipped, and the run recording them deleted their cassettes.
<<fixtures>>=
def log_in_for_tests(get_session, into_project):
  """Return the logged-in session from `get_session()`, or the reason why
  there is none.  Stops the run instead when we record into the project's
  cassettes, which a skipped test could delete."""
  try:
    session = get_session()
    session.user_info_JSON()
  except RecursionError:
    raise
  except RuntimeError as err:
    if into_project:
      pytest.exit(f"cannot log in to LADOK, so nothing is recorded: {err}",
                  returncode=1)
    return f"cannot log in to LADOK: {err}"
  return session
@

Let's verify the three outcomes with a login that fails the way a missing
login does, and with one that fails the way a looping login does.
We inject the failures: the real login would need credentials and LADOK.
<<test functions>>=
def no_stored_credentials():
  raise RuntimeError("no stored credentials")

def test_failed_login_stops_a_recording_into_the_project():
  with pytest.raises(pytest.exit.Exception):
    conftest.log_in_for_tests(no_stored_credentials, into_project=True)

def test_failed_login_skips_the_ladok_tests_of_a_live_run():
  reason = conftest.log_in_for_tests(no_stored_credentials,
                                     into_project=False)
  assert "no stored credentials" in reason

def test_a_login_that_loops_is_a_bug_not_a_missing_login():
  def looping_login():
    raise RecursionError("maximum recursion depth exceeded")

  with pytest.raises(RecursionError):
    conftest.log_in_for_tests(looping_login, into_project=False)
@

In replay, the tests get a session that never logs in.
It needs one thing that a logged-in session has: LADOK's [[XSRF-TOKEN]]
cookie, which the write requests send back (\cref{XSRFtoken}).
The cassettes keep the cookie but not its value, so a placeholder is enough.
Its value can be anything, but its domain cannot.
A session takes only the token that its own host set, so that the test
environment's token never stands in for production's
(\cref{XSRFtoken}).
A cookie set without a domain is not one that any host set, so the session
would not find it and every write request would fail before it is sent.
We therefore set the placeholder the way LADOK sets the real cookie: on the
bare host name of the session's [[base_url]], derived the same way the
session derives it when it looks the token up.
<<fixtures>>=
@pytest.fixture(scope="session")
def replay_ladok():
  """A session for LADOK's test environment that never logs in."""
  session = ladok3.LadokSession("KTH Royal Institute of Technology",
                                test_environment=True)
  host = urllib.parse.urlparse(session.base_url).hostname
  session.session.cookies.set("XSRF-TOKEN", vcr_support.SECRET_PLACEHOLDER,
                              domain=host)
  return session
@

The tests ask for [[ladok]] and get whichever session fits the mode.
In replay, a test without a cassette is skipped: without one, its first
request would only fail on the network block.
A test that uses [[ladok]] must be marked [[vcr]], though, or it is never
recorded: it would be skipped in replay for ever and talk to LADOK unrecorded
in a live run, outside the drift check.
We fail such a test rather than let it skip quietly.

Each test starts with an empty cache.
[[LadokSession]] caches some responses, such as the grade scales, and the
session is shared by all tests.
Without clearing it, what a test requests, and therefore what its cassette
holds, would depend on which tests ran before it: a test recorded after
another that filled the cache would, when run alone, make a request that its
cassette lacks.

The XSRF token needs the same care.
Before a PUT, POST or DELETE, [[LadokSession]] makes a request to refresh the
token if it has made none in the last 15 minutes (\cref{XSRFtoken}).
While recording, the shared session has always just been used, so that
request never happens; a replay session made a moment ago has not been used
at all, so it would.
We therefore mark the replay session as just used, before each test.
This reaches into a private attribute, which is the price of keeping the
freshness rule out of the public interface.

Finally, in replay we check that the test made every request its cassette
holds.
By default [[vcrpy]] only answers the requests that come; it doesn't notice
one that never comes.
A write test whose DELETE was never sent would then still pass, because the
requests after it replay the recorded state, in which the result is gone.
The check runs after the test's other fixtures are torn down, since they were
set up after [[ladok]], so it covers the cleanup's requests too.
<<fixtures>>=
@pytest.fixture
def ladok(request, recording, live_ladok, vcr,
          vcr_cassette_dir, default_cassette_name):
  """The LADOK session for a test: logged in when talking to LADOK, an
  offline one that replays the test's cassette otherwise."""
  if request.node.get_closest_marker("vcr") is None:
    pytest.fail("a test that uses the ladok fixture must be marked vcr")
  if recording:
    if isinstance(live_ladok, str):
      pytest.skip(live_ladok)
    live_ladok.cache.clear()
    yield live_ladok
    return
  cassette_file = Path(vcr_cassette_dir) / f"{default_cassette_name}.yaml"
  if not cassette_file.exists():
    pytest.skip("no recording; record it with --record-mode=once, "
                "or run with --live")
  session = request.getfixturevalue("replay_ladok")
  session.cache.clear()
  session._LadokSession__access_time = datetime.datetime.now()
  yield session
  assert vcr.all_played, (
    f"the test made {vcr.play_count} of the {len(vcr)} requests recorded "
    "in its cassette")
@

