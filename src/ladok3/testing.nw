We collect the public text from the response bodies in the cassette.
<<constants>>=
PUBLIC_TEXT_KEYS = {"sv", "en", "Text", "Benamning", "Kod"}
HTTP_METHODS = {"GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"}
PUBLIC_PATHS = ("/kataloginformation/internal/grunddata/",
                "/kataloginformation/internal/i18n/",
                "/kataloginformation/internal/service/",
                "/utbildningsinformation/internal/utbildningsinstans",
                "/utbildningsinformation/internal/utbildningstillfalle",
                "/utbildningsinformation/internal/struktur/")
PRIVATE_HEADERS = {"cookie", "set-cookie", "authorization",
                   "x-xsrf-token", "x-csrf-token"}
ESCAPE_SEQUENCE = r"\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)"
<<checks after the run>>=
def public_originals(originals, cassette):
  """Return the originals that occur in LADOK's public text in `cassette`,
  or that are HTTP methods."""
  text = "\n".join(public_text(cassette)).lower()
  words = set(re.findall(r"\w+", text))
  escaped = re.sub(ESCAPE_SEQUENCE, " ", yaml.safe_dump(text))
  words |= set(re.findall(r"\w+", escaped))
  phrases = vcr_support.Needles(original for original in originals
                                 if original.lower() not in words)
  found = {match.lower() for line in text.splitlines()
           for _, _, match in phrases.finditer(line)}
  return [original for original in originals
          if original.upper() in HTTP_METHODS
          or original.lower() in words
          or original.lower() in found]


def public_text(cassette):
  """Yield the public strings in the JSON response bodies of `cassette`:
  all of them from `PUBLIC_PATHS`, otherwise those under
  `PUBLIC_TEXT_KEYS`."""
  try:
    interactions = yaml.safe_load(cassette.read_text())["interactions"]
  except (yaml.YAMLError, KeyError, TypeError):
    return
  for interaction in interactions:
    yield from public_header_values(interaction)
    try:
      body = json.loads(interaction["response"]["body"]["string"])
    except (KeyError, TypeError, ValueError):
      continue
    uri = interaction.get("request", {}).get("uri", "")
    public = any(path in uri for path in PUBLIC_PATHS)
    yield from strings_under(body, PUBLIC_TEXT_KEYS, inside=public)


def public_header_values(interaction):
  """Yield the values of the request and response headers, except those
  that carry cookies or credentials."""
  for part in ("request", "response"):
    headers = (interaction.get(part) or {}).get("headers") or {}
    for name, values in headers.items():
      if name.lower() in PRIVATE_HEADERS:
        continue
      for value in values if isinstance(values, list) else [values]:
        if isinstance(value, str):
          yield value


def strings_under(data, keys, inside=False):
  """Yield the strings in `data` that sit under one of `keys`."""
  if isinstance(data, dict):
    for key, value in data.items():
      yield from strings_under(value, keys, inside or key in keys)
  elif isinstance(data, list):
    for item in data:
      yield from strings_under(item, keys, inside)
  elif inside and isinstance(data, str):
    yield data
@

Let's verify the allow list with two small cassettes that both contain the
original \enquote{Hammar}, invented for the test.
In the table of municipalities it is part of a public place name, written
with an escaped \enquote{ö} as in the real cassettes, so it is allowed there.
In a list of students it sits in a name field that the scrubber missed, so it
must be reported, even though the other cassette shows that it is also a word
in a place name.
\enquote{Max} occurs in a [[Cache-Control]] header and is allowed;
\enquote{Maxine} occurs only in a cookie, which is not public, and is not.
<<test functions>>=
def write_cassette(path, uri, body):
  interaction = {"request": {"uri": uri, "method": "GET"},
                 "response": {
                   "headers": {"Cache-Control": ["no-cache, max-age=0"],
                               "Set-Cookie": ["Maxine=redacted"]},
                   "body": {"string": json.dumps(body, ensure_ascii=False)}}}
  path.write_text(yaml.safe_dump({"interactions": [interaction]}))
  return path

def test_public_originals_are_allowed_per_cassette(tmp_path):
  places = write_cassette(
    tmp_path / "places.yaml",
    "https://start.test.ladok.se/gui/proxy"
    "/kataloginformation/internal/grunddata/kommun",
    {"Kommun": [{"ID": "1", "Kod": "1880",
                 "Benamning": {"sv": "Hammarö", "en": "Hammarö"}}]})
  students = write_cassette(
    tmp_path / "students.yaml",
    "https://start.test.ladok.se/gui/proxy"
    "/studiedeltagande/internal/deltagare",
    {"Resultat": [{"Student": {"Smeknamn": "Hammar"},
                   "Benamning": {"sv": "Datorteknik"}}]})
  originals = ["Hammar", "POST", "Datorteknik", "Max", "Maxine"]

  assert "Hammar" in conftest.public_originals(originals, places)
  assert "Hammar" not in conftest.public_originals(originals, students)
  assert set(conftest.public_originals(originals, students)) \
    == {"POST", "Datorteknik", "Max"}
