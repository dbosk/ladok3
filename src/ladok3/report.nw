def test_set_grade_retries_after_stale_attested_result():
  component = FakeComponent(
    grade="F", attested=True, finalized=True, date="2024-01-20",
    pull_updates=[{"attested": False, "finalized": False,
                   "grade": "F", "date": "2024-01-20"}])
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=False, verbose=0)

  ladok3.report.set_grade(
    ladok, args, "191212121212", "DD1315", "DD1315", "P",
    "2024-02-01", [])

  assert component.pull_calls == 1
  assert component.set_calls == [("P", datetime.date(2024, 2, 1))]
  assert component.finalize_calls == []


def test_set_grade_propagates_missing_result_after_refresh():
  component = FakeComponent(
    grade="F", attested=True, finalized=True, date="2024-01-20",
    pull_exception=ladok3.LadokNotFoundError(
      "DD1315: no result found in LADOK for refresh"))
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=False, verbose=0)

  with pytest.raises(
      ladok3.LadokNotFoundError,
      match="DD1315: no result found in LADOK for refresh"):
    ladok3.report.set_grade(
      ladok, args, "191212121212", "DD1315", "DD1315", "P",
      "2024-02-01", [])

  assert component.pull_calls == 1
  assert component.set_calls == []
