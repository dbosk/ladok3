def test_set_grade_warns_when_attested_date_differs(caplog):
  component = FakeComponent(
    grade="P", attested=True, finalized=True, date="2024-01-20")
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=True, verbose=0)

  with caplog.at_level(logging.WARNING, logger="ladok3.report"):
    ladok3.report.set_grade(
      ladok, args, "191212121212", "DD1315", "DD1315", "P",
      "2024-02-01", ["examiner"])

  assert component.pull_calls == 1
  assert component.set_calls == []
  assert component.finalize_calls == []
  warnings = [r for r in caplog.records
              if r.levelno == logging.WARNING
              and r.name == "ladok3.report"]
  assert len(warnings) == 1
  assert "examination date 2024-01-20" in warnings[0].message
  assert "leaving the attested result as-is" in warnings[0].message


