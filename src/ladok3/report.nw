def test_set_grade_updates_draft_result():
  component = FakeComponent()
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=True, verbose=0)

  ladok3.report.set_grade(
    ladok, args, "191212121212", "DD1315", "DD1315", "P",
    "2024-02-01", ["examiner"])

  assert component.set_calls == [("P", datetime.date(2024, 2, 1))]
  assert component.finalize_calls == [["examiner"]]


def test_set_grade_updates_draft_result_date_without_grade_change():
  component = FakeComponent(grade="P", date="2024-01-20")
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=False, verbose=0)

