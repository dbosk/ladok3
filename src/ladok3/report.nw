def test_set_grade_attested_date_warning_suppressed_at_error_level(caplog):
  component = FakeComponent(
    grade="P", attested=True, finalized=True, date="2024-01-20")
  course = FakeCourse(component)
  student = FakeStudent(course)
  ladok = FakeLadok(student)
  args = types.SimpleNamespace(finalize=True, verbose=0)

  report_logger = logging.getLogger("ladok3.report")
  previous_level = report_logger.level
  report_logger.setLevel(logging.ERROR)
  try:
    with caplog.at_level(logging.ERROR, logger="ladok3.report"):
      ladok3.report.set_grade(
        ladok, args, "191212121212", "DD1315", "DD1315", "P",
        "2024-02-01", ["examiner"])
  finally:
    report_logger.setLevel(previous_level)

  assert component.pull_calls == 1
  assert component.set_calls == []
  # The WARNING record is filtered out by the logger level itself
  # (mimicking what -q does at the CLI), so caplog never sees it.
  assert [r for r in caplog.records
          if r.name == "ladok3.report"] == []


