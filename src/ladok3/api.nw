  courses = [c for c in student.courses()
             if c.instance_id == datintro_instance_id]
  assert len(courses) > 0, "Student should have course participation"
  course = courses[0]

  # Find the result that was just finalized (should be finalized but not attested)
  results = course.results()
  finalized_results = [r for r in results
                       if r.finalized and not r.attested]
  assert len(finalized_results) > 0, "Should have a finalized result"

