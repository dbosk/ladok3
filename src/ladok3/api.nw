def utbildningsinstans_JSON(self, inst_uid: str) -> dict:
  """Fetch an education-instance record by its UID.

  Uses GET /utbildningsinformation/internal/utbildningsinstans/{uid}.
  """
  return self.get_query(
    f"/utbildningsinformation/internal/utbildningsinstans/{inst_uid}",
    "application/vnd.ladok-utbildningsinformation+json",
  )
