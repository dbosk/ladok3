To filter a list of participations, we classify each of them on the same
day, so that a list never straddles midnight.
<<functions>>=
def participations_in_state(participations: list, state: str,
                            today=None) -> list:
  """Return the participations that our rule puts in `state`, one of
  PARTICIPATION_STATES, judged on `today` (default: today in Sweden).

  Participations that the rule cannot place are left out; ask LADOK
  (LadokSession.student_participations_JSON) for those.
  """
  check_participation_state(state)
  if today is None:
    today = swedish_today()
  return [participation for participation in participations
          if participation_state(participation, today) == state]
@

Let's verify the rule, row by row, on a fixed date.
Each case is a participation as LADOK returns it, with the full summary
token, so that we also check that only the last component counts.
The cases mark the dates relative to the fixed date: a round that has ended,
one that runs, one that has not started, and the two boundary days.
<<test functions>>=
TODAY = datetime.date(2026, 10, 20)
ENDED = ("2026-01-19", "2026-06-05")
RUNNING = ("2026-08-31", "2027-01-15")
UPCOMING = ("2027-01-19", "2027-06-04")
STARTS_TODAY = ("2026-10-20", "2027-01-15")
ENDS_TODAY = ("2026-08-31", "2026-10-20")

def make_participation(summary, dates):
  start, end = dates
  return {
    "TillstandKurs": {"Sammanfattattillstand":
                        f"studiedeltagande.domain.tillstandsdefinition."
                        f"{summary}"},
    "Utbildningsinformation": {"Studieperiod": {"Startdatum": start,
                                                "Slutdatum": end}},
  }

@pytest.mark.parametrize("summary,dates,state", [
  ("avklarad", ENDED, "avslutade"),
  ("avklarad", RUNNING, "avslutade"),
  ("avbrott", RUNNING, "avbrott"),
  ("avbrott", ENDED, "avbrott"),
  ("registrerad", RUNNING, "pagaende"),
  ("omregistrerad", RUNNING, "pagaende"),
  ("registrerad", ENDED, "oavslutade"),
  ("omregistrerad", ENDED, "oavslutade"),
  ("ej_paborjad", UPCOMING, "kommande"),
  ("ej_paborjad", RUNNING, "kommande"),
  ("ej_paborjad", ENDED, None),
  ("aterbud", UPCOMING, None),
  ("aterbud", RUNNING, None),
  ("aterbud", ENDED, None),
  ("tidigtavbrott", RUNNING, None),
  ("tidigtavbrott", ENDED, None),
  ("registrerad", STARTS_TODAY, "pagaende"),
  ("registrerad", ENDS_TODAY, "pagaende"),
  ("registrerad", UPCOMING, ladok3.UNKNOWN_STATE),
  ("omregistrerad", UPCOMING, ladok3.UNKNOWN_STATE),
  ("nagot_nytt", RUNNING, ladok3.UNKNOWN_STATE),
])
def test_participation_state(summary, dates, state) -> None:
  participation = make_participation(summary, dates)
  assert ladok3.participation_state(participation, TODAY) == state
